{
  "workbench.sideBar.location": "right",
  "workbench.welcome.enabled": false,
  "editor.suggestSelection": "first",
  "editor.snippetSuggestions": "inline",
  "editor.inlineSuggest.enabled": true,
  "editor.fontLigatures": true,
  "editor.tabCompletion": "on",
  // "editor.fontWeight": "600",
  "editor.fontWeight": "340",
  "editor.renderWhitespace": "trailing",
  "editor.fontFamily": "Hack NF, Hack Nerd Font, JetBrainsMono Nerd Font Mono, Cascadia Code, Open Sans Light, Cascadia Code, Input Mono, Hack Nerd Font, Consolas, Lucida Console, Monospace",
  "terminal.integrated.fontSize": "12",
  // "terminal.integrated.fontFamily": "",
  // "editor.fontFamily": "JetBrains Mono Nerd Font",
  // "editor.fontFamily": "JetBrains Mono Regular",
  // "editor.fontFamily": "JetBrainsMonoNL Nerd Font",
  // Optionals ->
  // "editor.letterSpacing": 1,
  // "editor.letterSpacing": 1.6,
  "editor.letterSpacing": 0.4,
  // "editor.lineHeight": 1.518,
  // "editor.lineHeight": 1.129,
  // "editor.lineHeight": 1.219,
  "editor.lineHeight": 1.3,
  // "editor.lineHeight": 1.619,
  // "editor.fontSize": 12,
  // "editor.fontSize": 13,
  // "editor.fontSize": 13.5,
  // "editor.fontSize": 14,
  // "editor.fontSize": 15,
  // "editor.fontSize": 16,
  "editor.cursorBlinking": "expand",
  "editor.codeLensFontFamily": "Consolas",
  "editor.autoIndent": "full",
  // VIM
  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.textColor": "cyan",
  "vim.highlightedyank.color": "rgba(250, 240, 170, 0.1)",
  // "vim.smartRelativeLine": true,
  "vim.camelCaseMotion.enable": true,
  "vim.autoindent": true,
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "j"],
      "after": ["<Esc>"]
    },
    {
      "before": ["h", "h"],
      "after": ["<Esc>"]
    },
    {
      "before": ["k", "k"],
      "after": ["<Esc>"]
    }
  ],
  "vim.normalModeKeyBindings": [
    {
      // Cut this line
      "before": ["<leader>", "d"],
      "after": ["d", "d"]
    },
    {
      // Delete this line
      "before": ["<leader>", "x"],
      "after": ["\"", "_", "d", "d"]
    },
    {
      // Delete until space
      "before": ["d", "<leader>", "d"],
      "after": ["d", "t", "<Space>"]
    },
    {
      // Yank until space
      "before": ["y", "<leader>", "y"],
      "after": ["y", "t", "<Space>"]
    },
    {
      "before": ["<C-n>"],
      "commands": [":nohl"]
    },
    {
      // Change to the next editor
      "before": ["<tab>"],
      "commands": ["workbench.action.nextEditor"]
    },
    {
      "before": ["<S-tab>"],
      "commands": ["workbench.action.previousEditor"]
    },
    {
      // !J
      "before": ["¿"],
      "after": ["f", "<Space>", "a", "<CR>", "<Esc>"]
    },
    {
      // ¡ f , ?
      "before": ["¡"],
      "after": ["f", ",", "¿", "<Esc>"]
    },
    {
      // insert br after }
      "before": ["<leader>", "2", "¿"],
      "after": ["f", "}", "i", "<CR>", "<Esc>"]
    },
    {
      // find ; <CR>
      "before": ["!"],
      "after": ["f", ";", "w", "i", "<CR>", "<Esc>"]
    }
  ],
  "vim.visualModeKeyBindings": [
    {
      // Fast horizontal movement
      "before": ["<leader>", "h"],
      "after": ["_"]
    },
    {
      // Fast horizontal movement
      "before": ["<leader>", "l"],
      "after": ["$"]
    },
    {
      // Better indent
      "before": [">"],
      "after": [">", "g", "v"]
    },
    {
      // Better indent
      "before": ["<"],
      "after": ["<", "g", "v"]
    }
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      // Fast horizontal movement
      "before": ["<leader>", "h"],
      "after": ["_"]
    },
    {
      // Fast horizontal movement
      "before": ["<leader>", "l"],
      "after": ["$"]
    },
    {
      // Fast C Crolling down
      "before": ["<leader>", "j"],
      "after": ["9", "j"]
    },
    {
      // Fast C Crolling up
      "before": ["<leader>", "k"],
      "after": ["9", "k"]
    },

    {
      // Cut without yank
      "before": ["x"],
      "after": ["\"", "_", "x"]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      // Split editor vertically
      "before": ["s", "v"],
      "commands": ["workbench.action.splitEditor"]
    },
    {
      // Split editor horizontally
      "before": ["s", "s"],
      "commands": ["workbench.action.splitEditorDown"]
    },
    {
      // Jump cursor to another buffer
      "before": ["<C-Space>"],
      "after": ["<C-w>", "w"]
    },
    {
      // Move cursor to the left buffer
      "before": ["s", "h"],
      "after": ["<C-w>", "h"]
    },
    {
      // Move cursor to the right buffer
      "before": ["s", "l"],
      "after": ["<C-w>", "l"]
    },
    {
      // Move cursor to the down buffer
      "before": ["s", "j"],
      "after": ["<C-w>", "j"]
    },
    {
      // Move cursor to the up buffer
      "before": ["s", "k"],
      "after": ["<C-w>", "k"]
    },
    {
      // Fast scrolling
      "before": ["<C-e>"],
      "after": ["9", "<C-e>"]
    },
    {
      // Fast scrolling
      "before": ["<C-y>"],
      "after": ["9", "<C-y>"]
    },
    {
      // Insert a new line up
      "before": ["<leader>", "<leader>", "o"],
      "after": ["O"]
    },
    {
      // Save and quit the current editor
      "before": ["<leader>", "q"],
      "commands": [":wq!"]
    },
    {
      // Toggle file sideBar
      "before": ["<leader>", "e"],
      "commands": ["workbench.action.toggleSidebarVisibility"]
    },
    {
      // Toggle activityBar
      "before": ["<leader>", "2", "t"],
      "commands": ["workbench.action.toggleActivityBarVisibility"]
    },
    {
      // Reveal current file in fileExplorer
      "before": ["<leader>", "f"],
      "commands": ["revealInExplorer"]
    },
    {
      // Reveal current file in fileExplorer
      "before": ["s", "f"],
      "commands": ["revealInExplorer"]
    },
    {
      "before": ["<leader>", "r", "f"],
      "commands": ["fileutils.renameFile"]
    },
    {
      // Fast horizontal movement
      "before": ["<leader>", "h"],
      "after": ["_"]
    },
    {
      // Fast horizontal movement
      "before": ["<leader>", "l"],
      "after": ["$"]
    },
    {
      // Decrement number
      "before": ["-"],
      "after": ["<C-x>"]
    },
    {
      // Increment number
      "before": ["+"],
      "after": ["<C-a>"]
    },
    {
      // Exit fast like EL ZORRO
      "before": ["<leader>", "z"],
      "after": ["Z", "Z"]
    },
    {
      // Open last file
      "before": ["<leader>", "o"],
      "after": ["<C-o>"]
    },
    {
      // Delete until '
      "before": ["<leader>", "C"],
      "after": ["d", "t", "'"]
    },
    {
      // Delete until "
      "before": ["<leader>", "c"],
      "after": ["d", "t", "\""]
    },
    {
      // Delete until >
      "before": ["<leader>", "m"],
      "after": ["d", "t", ">"]
    },
    {
      // Delete until <
      "before": ["<leader>", "M"],
      "after": ["d", "t", "<"]
    },
    {
      // Delete until ;
      "before": ["<leader>", "p"],
      "after": ["d", "t", ";"]
    },
    {
      // Delete until )
      "before": ["<leader>", "9"],
      "after": ["d", "t", ")"]
    },
    {
      // Delete until (
      "before": ["<leader>", "8"],
      "after": ["d", "t", "("]
    },
    {
      // Delete until .
      "before": ["<leader>", "."],
      "after": ["d", "t", "."]
    },
    {
      // change internal '
      "before": ["<leader>", "1", "i"],
      "after": ["c", "i", "'"]
    },
    {
      // change internal "
      "before": ["<leader>", "1", "2", "i"],
      "after": ["c", "i", "\""]
    },
    {
      // from Cursor delete until ,
      "before": ["<leader>", ","],
      "after": ["d", "t", ",", "s", "<Esc>"]
    },
    {
      // Quick semi
      "before": ["<leader>", "2", ","],
      "after": ["$", "a", ","]
    },
    {
      // from C delete until ]
      "before": ["<leader>", "2", "}"],
      "after": ["d", "t", "]"]
    },
    {
      // from C delete until }
      "before": ["<leader>", "}"],
      "after": ["d", "t", "}"]
    },
    {
      // from C delete until /
      "before": ["<leader>", "7"],
      "after": ["d", "t", "/"]
    },
    {
      // Fast C Crolling down
      "before": ["<leader>", "j"],
      "after": ["9", "j"]
    },
    {
      // Fast C Crolling up
      "before": ["<leader>", "k"],
      "after": ["9", "k"]
    },
    {
      // ULTRAFast C Crolling down
      "before": ["<leader>", "4", "j"],
      "after": ["4", "9", "j"]
    },
    {
      // ULTRAFast C Crolling up
      "before": ["<leader>", "4", "k"],
      "after": ["4", "9", "k"]
    },
    {
      // Fast scrolling to end of the current document
      "before": ["<leader>", "g"],
      "after": ["G", "G"]
    },
    {
      // Insert `
      "before": ["<leader>", "b"],
      "after": ["i", "`"]
    },
    {
      // Fast delete entire current document
      "before": ["<leader>", "backspace"],
      "after": ["g", "g", "d", "G"]
    },
    {
      // Select entire current document
      "before": ["<leader>", "a"],
      "after": ["g", "g", "v", "G"]
    },
    {
      // Change internal word
      "before": ["<leader>", "n"],
      "after": ["c", "i", "w"]
    },
    {
      // Change internal t
      "before": ["<leader>", "N"],
      "after": ["c", "i", "t"]
    },
    {
      // Change internal B
      "before": ["<leader>", "B"],
      "after": ["c", "i", "B"]
    },
    {
      // Change internal b
      "before": ["<leader>", "2", "b"],
      "after": ["c", "i", "b"]
    },
    {
      // Copy internal b
      "before": ["<leader>", "y"],
      "after": ["y", "i", "w"]
    },
    {
      // Fold recursively
      "before": ["<leader>", "'"],
      "commands": ["editor.foldRecursively"]
    },
    {
      // Peek definition
      "before": ["<leader>", "i"],
      "commands": ["editor.action.peekDefinition"]
    },
    {
      // Peek references definition
      "before": ["<leader>", "2", "i"],
      "commands": ["editor.action.goToReferences"]
    },
    {
      // Run this document
      "before": ["<leader>", "r"],
      "commands": ["workbench.action.debug.run"]
    },
    {
      // Save the current document
      "before": ["<leader>", "s"],
      "commands": ["workbench.action.files.save"]
    },
    {
      // Search file in current folder
      "before": ["<leader>", "S"],
      "commands": ["workbench.view.search"]
    },
    {
      // Open terminal
      "before": ["<leader>", "ñ"],
      "commands": ["workbench.action.terminal.focusPreviousPane"]
    },
    {
      // Hide down Pane
      "before": ["<leader>", "u"],
      "commands": [
        "workbench.action.output.toggleOutput",
        "workbench.action.output.toggleOutput"
      ]
    },
    {
      // Toggle comment line
      "before": ["<leader>", "1"],
      "commands": ["editor.action.commentLine"]
    },
    {
      // Toggle inlineFold
      "before": ["<leader>", "t"],
      "commands": ["inlineFold.toggle"]
    },
    {
      // rpl
      "before": ["<leader>", "2", "f"],
      "after": ["<Cmd>", ":", "%", "s", "/", "\"", "/", "'", "/", "g", "return"]
    },
    {
      // !rpl
      "before": ["<leader>", "3", "f"],
      "after": ["<Cmd>", ":", "%", "s", "/", "'", "/", "\"", "/", "g", "return"]
    },
    {
      // rpl ; -> void
      "before": ["<leader>", "4", "f"],
      "after": ["<Cmd>", ":", "%", "s", "/", ";", "/", "/", "g", "return"]
    },
    {
      // cSpell toggle
      "before": ["<leader>", "c", "s"],
      "commands": ["cSpell.toggleEnableForGlobal"]
    },
    {
      // Clear local search with vim
      "before": ["<leader>", "2", "l"],
      "after": ["/", "/", "/", "/", "/", "<CR>"]
    },
    {
      // Open source control vscode
      "before": ["<leader>", "g"],
      "commands": ["workbench.view.scm"]
    },
    {
      // Toggle activity bar visibility
      "before": ["<leader>", "2", "t"],
      "commands": ["workbench.action.toggleActivityBarVisibility"]
    },
    {
      // Toggle activity bar visibility
      "before": ["<leader>", "X"],
      "commands": ["workbench.view.extensions"]
    },
    {
      // Cut without yank
      "before": ["x"],
      "after": ["\"", "_", "x"]
    },
    {
      // Insert ; to the end line
      "before": ["<leader>", "3", ","],
      "after": ["$", "a", ";", "ESC"]
    }
  ],
  "vim.leader": "<space>",
